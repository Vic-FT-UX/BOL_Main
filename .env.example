# Design Studio — names only, never commit real secrets.

# Human passcode for studio + live site (client-side gate). Default is 1966.
PUBLIC_STUDIO_PASS=1966

# Figma design system the team is locked to (Lumen).
# File key from https://www.figma.com/design/<FILE_KEY>/...
PUBLIC_FIGMA_DS_FILE_KEY=vCPe93hNKDWWcpu49Vo0kU
PUBLIC_FIGMA_DS_LIBRARY_NAME=Lumen_Desing System

# Where outputs land (shown in the UI; the agents deploy to these).
PUBLIC_LIVE_SITE_BRAND=betonline
PUBLIC_LIVE_SITE_URL=http://localhost:3000
# Initiative prototypes — own Next port, NOT demo :3000. Merge to demo when Chris says so.
PUBLIC_PROTOTYPE_BASE_URL=http://127.0.0.1:3001/prototype
NEXT_PUBLIC_PROTOTYPE_ORIGIN=http://127.0.0.1:3001
# Local Storybook. On Vercel, set NEXT_PUBLIC_STORYBOOK_URL to a public host — never leave loopback.
PUBLIC_STORYBOOK_URL=http://127.0.0.1:6006
# NEXT_PUBLIC_STORYBOOK_URL=https://your-storybook.example.com


# Real humans an agent may ping for a reference when it is stuck (comma-separated).
PUBLIC_HUMAN_REVIEWERS=Chris

# Future server-only keys (never prefix with PUBLIC_)
# Cursor user API key — studio local + design-desk cloud kicks on Vercel.
# https://cursor.com/dashboard/integrations
# CURSOR_API_KEY=
# Cloud Design agent (design desk on Vercel) — repo the agent clones + PRs.
# CURSOR_CLOUD_REPO=https://github.com/Stottiefingaz86/AI-Design-Stream
# CURSOR_CLOUD_REF=main
# Vercel Blob — durable SpecKit jobs on serverless (linked store / auto token).
# BLOB_READ_WRITE_TOKEN=
# FIGMA_ACCESS_TOKEN=
# GITHUB_TOKEN=
# VERCEL_TOKEN=
# Bearer for POST/GET /api/agent/brd (open when unset — local /Designagent)
# AGENT_INTAKE_TOKEN=

# shadcn/studio registry (https://shadcnstudio.com) — used by `npx shadcn add @ss-components/...`
EMAIL=
LICENSE_KEY=
